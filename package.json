{
  "name": "transcribe",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "tsc && tsc -p tsconfig.worker.json && tsc -p tsconfig.test.json && node --test dist-test/**/*.test.js",
    "demo": "tsc && node dist/demo/play-melody.js",
    "dev": "vite",
    "build:web": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy -c dist-web/transcribe/wrangler.json",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply transcribe --local",
    "db:migrate:remote": "wrangler d1 migrations apply transcribe --remote"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@types/node": "^25.9.3",
    "typescript": "^5.8.3",
    "vite": "^8.1.5",
    "wrangler": "^4.119.0"
  },
  "dependencies": {
    "hono": "^4.13.0",
    "vexflow": "5.0.0"
  }
}
