{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // The Worker's own name, and nothing else's: it decides how the script is
  // listed in the dashboard and what its workers.dev URL would be called. No
  // code reads it, and it need not match the repo, the database, or the
  // address — which is now the case, and deliberately so.
  //
  // It was named after the address when the two agreed. They no longer do:
  // the site moved to tuneup.jasonmao.me and this stayed "transcribe",
  // because renaming a Worker after a deploy does not rename it — it creates
  // a second one and leaves the first serving. There is a second reason now
  // as well. The build writes its generated config to `dist-web/<this
  // name>/wrangler.json`, and package.json's `deploy` script names that path
  // literally, so a rename here breaks the release until package.json is
  // changed to match. Nobody ever sees this name. It stays.
  "name": "transcribe",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-07",

  // No `directory` here on purpose: the Vite plugin writes one into the
  // generated config at build time, pointing at whatever the client build
  // produced. Setting it by hand is how the two drift apart.
  //
  // Assets win by default, so the Worker only ever sees a request no file
  // answers — which is every /api/* path, and nothing else worth serving.
  //
  // Except that "assets win" has a sharper edge for *navigations*: since
  // compatibility date 2025-04-01, a navigated path with no matching file is
  // answered by the 404 page directly, and the Worker never runs. Most of
  // /api never notices, because pages reach it with fetch() — but sign-in is
  // a chain of top-level navigations by design (that is what SameSite=Lax
  // cookies travel on), so without the line below, clicking "Sign in" lands
  // on "Nothing here" instead of Google. This sends /api to the Worker
  // before any of that, navigations included.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },

  // The site's address. A custom domain is a door to the Worker, not a
  // second deployment: `npm run deploy` is the whole release, and it serves
  // here the moment it finishes. Declared here rather than in the dashboard
  // so that deploying is enough — Cloudflare writes the DNS record and issues
  // the certificate itself. The jasonmao.me zone has to be on Cloudflare DNS
  // for that to work, and it is.
  //
  // It was transcribe.jasonmao.me until the site took the name it goes by.
  // One line, because nothing else in the codebase knows the address:
  // `redirect_uri` is built from whatever origin the request arrived on (see
  // worker/auth.ts), so the move needed no code change — only the new
  // callback added to the Google console's list, which is the one place
  // outside this repo that has to agree.
  //
  // This list is declarative for custom domains, which is the opposite of
  // what is easy to assume. Deploying with only this address in it detached
  // transcribe.jasonmao.me by itself: the dashboard entry went, the DNS
  // record went with it, and the hostname stopped resolving altogether. So
  // this is the set of addresses the Worker answers on, not a set of
  // additions to it -- dropping one from here switches that hostname off at
  // the next deploy.
  "routes": [{ "pattern": "tuneup.jasonmao.me", "custom_domain": true }],

  // One door, on purpose. The workers.dev hostname is closed so that the site
  // has exactly one origin — the one on Google's redirect allowlist. (Wrangler
  // closes it by default once `routes` exists; saying so here keeps that from
  // being a surprise.) Preview URLs would reopen the workers.dev subdomain for
  // `wrangler versions upload` pre-flights; flip to true the day that is
  // wanted.
  "workers_dev": false,
  "preview_urls": false,

  // Named after the application rather than after any one table: it began
  // life as "transcriptions" when that was the only table, and was moved
  // (D1 cannot rename, so: created anew, contents carried over) once users
  // and sessions arrived to share it.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "transcribe",
      "database_id": "1e9e85a5-72af-4bb8-9587-774877b6d489"
    }
  ],

  // How often one caller may ask. Six buckets rather than one, because what a
  // request costs here varies by two orders of magnitude: see worker/limits.ts,
  // which holds the policy and the reasoning, and is the only place that needs
  // reading to know what is limited.
  //
  // `period` may be 10 or 60 and nothing else, so every window here is a
  // minute. The counts are kept per data centre rather than globally --
  // Cloudflare calls the whole thing "permissive, eventually consistent" — so
  // these are a brake on scripted abuse, not a quota, and a caller spread
  // across the world gets more than the number says.
  //
  // The namespace ids are arbitrary and only have to differ from each other;
  // renumbering one empties its counts, which costs nothing but a minute.
  "ratelimits": [
    // The answer oracle: roughly forty of these can pin one note, and it is
    // the one write that takes no session at all. Tightest by a long way,
    // and still well above a real player, who checks every ten seconds or so.
    { "name": "RL_CHECK", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    // The sign-in dance. Two requests per sign-in, and the callback spends an
    // outbound call to Google.
    { "name": "RL_AUTH", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    // Making a tune, moving one across the publish line, throwing one away,
    // deleting an account, and the merge — whose loop is two statements per
    // record, for up to a hundred records.
    { "name": "RL_HEAVY", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    // The two listings: a hundred rows with five correlated subselects each,
    // which is the most expensive read here. A page a second is generous for
    // somebody browsing and holds the query to a page a second for anybody
    // else.
    { "name": "RL_LIST", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
    // Ordinary writes. Not tighter than this because the play page saves
    // progress about once a second while somebody is actually playing.
    { "name": "RL_WRITE", "namespace_id": "1005", "simple": { "limit": 120, "period": 60 } },
    // Every remaining read. A play page opens with six of these.
    { "name": "RL_READ", "namespace_id": "1006", "simple": { "limit": 240, "period": 60 } }
  ],

  // Google sign-in. The client id is public by nature — it travels in every
  // sign-in redirect — so it can live here in the open. The client secret
  // must not: it is `wrangler secret put GOOGLE_CLIENT_SECRET` for the
  // deployed Worker, and a line in .dev.vars (gitignored) for local work,
  // where both of these can be overridden. Left empty, sign-in answers 503
  // with a sentence rather than sending anybody to Google with a blank
  // application name.
  "vars": {
    "GOOGLE_CLIENT_ID": "824101453235-c23446n3gm01kqnurnogsupjjgfj1d6k.apps.googleusercontent.com"
  }
}
